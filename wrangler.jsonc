{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcn-udo-umana",
  "compatibility_date": "2026-10-02",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "previews": {}
}
