---
import { navItems, site } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-primary">
      <div class="footer-brand">
        <img
          src={site.logo}
          alt="Methodist Church Nigeria crest"
          width="61"
          height="60"
          loading="lazy"
        />
        <div>
          <strong>{site.name}</strong>
          <span>{site.branch}</span>
        </div>
      </div>

      <nav class="footer-menu" aria-label="Footer navigation">
        <ul>
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-follow">
      <div class="footer-social-row">
        <h2>FOLLOW US</h2>
        <div class="social-links">
          <a
            href={site.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit our Facebook page"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="11" fill="#1877f2" />
              <path fill="#fff" d="M13.6 19v-6h2l.3-2.3h-2.3V9.2c0-.7.2-1.1 1.2-1.1H16V6c-.2 0-1-.1-1.8-.1-1.8 0-3 1.1-3 3.1v1.7H9.1V13h2.1v6h2.4Z" />
            </svg>
          </a>
          <a
            href={site.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit our YouTube channel"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <rect x="1" y="4.5" width="22" height="15" rx="4" fill="#ff0033" />
              <path fill="#fff" d="m10 9 5 3-5 3V9Z" />
            </svg>
          </a>
        </div>
      </div>

      <a class="footer-phone" href={site.phoneHref} aria-label={`Call ${site.phoneDisplay}`}>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2.1Z" />
        </svg>
        <span>{site.phoneDisplay}</span>
      </a>
    </div>

    <p class="copyright">© 2026. Methodist Church Nigeria, 67 Udo Umana. All right reserved</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #fff;
  }

  .footer-inner {
    width: 100%;
    max-width: 1440px;
    min-height: 408px;
    margin-inline: auto;
    padding: 54px 112px 42px;
    display: grid;
    grid-template-columns: minmax(0, 492px) auto;
    column-gap: 48px;
    row-gap: 38px;
    align-content: start;
    justify-content: space-between;
    position: relative;
  }

  .footer-primary {
    display: flex;
    width: 492px;
    max-width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 16px;
    text-transform: uppercase;
  }

  .footer-brand img {
    width: 61px;
    height: 60px;
    flex: none;
    object-fit: contain;
  }

  .footer-brand div {
    display: grid;
    line-height: 18px;
    text-transform: uppercase;
  }

  .footer-brand strong,
  .footer-brand span {
    font-size: 14px;
    line-height: 18px;
  }

  .footer-brand strong {
    color: #fff;
    font-weight: 400;
    letter-spacing: 0;
  }

  .footer-brand span {
    color: var(--gold);
    font-weight: 600;
  }

  .footer-menu ul {
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-menu li,
  .footer-menu a {
    font-size: 13px;
    line-height: 21px;
  }

  .footer-menu a {
    color: #fff;
    transition: color 160ms ease;
  }

  .footer-menu a:hover,
  .footer-menu a.active,
  .footer-menu a[aria-current='page'] {
    color: var(--gold);
  }

  .footer-follow {
    display: flex;
    min-width: 0;
    padding-top: 8px;
    flex-direction: column;
    align-items: flex-end;
    gap: 26px;
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .footer-social-row h2 {
    margin: 0;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: 0;
  }

  .social-links {
    display: flex;
    gap: 4px;
    margin: 0;
  }

  .social-links a {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 0;
    background: transparent;
  }

  .social-links svg {
    display: block;
    width: 20px;
    height: 20px;
  }

  .footer-phone {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #fff;
    font-size: 12px;
    line-height: 21px;
  }

  .footer-phone svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copyright {
    position: static;
    grid-column: 1 / -1;
    justify-self: center;
    width: calc(100% - 24px);
    max-width: 1211px;
    margin: 0;
    padding-top: 34px;
    border-top: 2px solid #281564;
    color: #cbcacd;
    font-size: 10px;
    line-height: 18px;
    text-align: center;
  }

  .site-footer a:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  @media (min-width: 810px) and (max-width: 1439.98px) {
    .footer-inner {
      padding-inline: clamp(48px, 7.6vw, 78px);
    }
  }

  @media (max-width: 809.98px) {
    .footer-inner {
      min-height: 0;
      padding: 48px 24px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .footer-primary {
      width: 100%;
      gap: 0;
    }

    .footer-brand img {
      width: 52px;
      height: 52px;
    }

    .footer-brand strong,
    .footer-brand span {
      font-size: 12px;
      line-height: 16px;
    }

    .footer-menu {
      display: none;
    }

    .footer-follow {
      width: 100%;
      margin-top: 56px;
      padding: 0;
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
    }

    .footer-social-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .footer-social-row h2 {
      font-size: 12px;
    }

    .social-links {
      gap: 8px;
    }

    .social-links a {
      width: 32px;
      height: 32px;
    }

    .social-links svg {
      width: 24px;
      height: 24px;
    }

    .footer-phone {
      margin-top: 2px;
      font-size: 11px;
      white-space: nowrap;
    }

    .copyright {
      width: 100%;
      max-width: 342px;
      margin-top: 32px;
      padding-top: 28px;
      font-size: 9px;
      line-height: 16px;
    }
  }

  @media (max-width: 389.98px) {
    .footer-inner {
      padding-inline: 18px;
    }

    .footer-follow {
      gap: 14px;
    }

    .footer-phone {
      font-size: 10px;
    }
  }
</style>
